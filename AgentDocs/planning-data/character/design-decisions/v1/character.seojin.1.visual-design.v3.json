    "seojin.appearance.gender_presentation.v3": {
      "fieldPath": "/appearance/genderPresentation",
      "value": {
        "description": "20대 중후반의 젊은 성인 한국 남성으로 명확히 읽히는 시각 표현. 미성년처럼 보이지 않으며 군졸 출신 떠돌이 검사의 실용적이고 절제된 인상을 유지한다."
      }
    },
    "seojin.appearance.body.v3": {
      "fieldPath": "/appearance/body",
      "value": {
        "description": "20대 중후반의 젊은 성인으로 보이는 보통 키의 균형 잡힌 단단한 체형. 민첩한 전열 검사로 읽히는 탄탄한 어깨와 팔을 가지되 과장된 거구, 노쇠한 체형, 영웅적 신체 비례는 사용하지 않는다."
      }
    },
    "seojin.appearance.face.v3": {
      "fieldPath": "/appearance/face",
      "value": {
        "description": "젊고 단정하며 매력적인 한국 남성의 얼굴. 균형 잡힌 갸름한 얼굴형, 깨끗하고 선명한 턱선, 곧은 눈썹, 또렷하고 차분한 눈매를 갖는다. 피부에는 햇볕과 여행의 흔적을 아주 옅게 남기되 깊은 주름, 짙은 피로, 거친 노숙 인상은 피한다. 얼굴은 깨끗하게 면도한 상태로 표현한다."
      }
    },
    "seojin.appearance.hair.v3": {
      "fieldPath": "/appearance/hair",
      "value": {
        "description": "윤기 있는 검은 머리를 조선시대 젊은 성인 남성의 낮고 단단한 상투로 단정하게 묶는다. 관자와 목덜미의 잔머리는 최소화하며 현대식 헤어스타일, 화려한 관모, 이국적인 장식은 사용하지 않는다."
      }
    },
    "seojin.appearance.identifying_features.v3": {
