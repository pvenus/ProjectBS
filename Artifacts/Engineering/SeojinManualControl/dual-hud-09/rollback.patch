- Test("HUD pointer-over-UI hides both per owner no-intent policy",()=>{var x=HudRig();Input.mousePosition=new Vector3(9,0,0);Input.Held.Add(KeyCode.W);UnityEngine.EventSystems.EventSystem.current=new UnityEngine.EventSystems.EventSystem{Over=true};HudTick(x.hud);Check(!HudField<SpriteRenderer>(x.hud,"red").enabled&&!HudField<SpriteRenderer>(x.hud,"blue").enabled,"pointer UI leaked intent");});
- Test("HUD aura render visibility suppresses hidden marker",()=>{var x=HudRig();Input.mousePosition=new Vector3(9,0,0);Input.Held.Add(KeyCode.W);x.aura.BackArcRenderer.enabled=false;HudTick(x.hud);Check(!HudField<SpriteRenderer>(x.hud,"red").enabled&&!HudField<SpriteRenderer>(x.hud,"blue").enabled,"invisible aura leaked HUD");});
- Test("HUD missing sprites stay hidden no retry allocations and rebind recovers",()=>{typeof(SeojinDualDirectionHud).GetField("redSprite",BindingFlags.Static|BindingFlags.NonPublic).SetValue(null,null);typeof(SeojinDualDirectionHud).GetField("blueSprite",BindingFlags.Static|BindingFlags.NonPublic).SetValue(null,null);Resources.Missing=true;var x=HudRig();Input.mousePosition=new Vector3(9,0,0);Input.Held.Add(KeyCode.W);var pivot=HudField<Transform>(x.hud,"redPivot");int loads=Resources.Loads;for(int i=0;i<50;i++)HudTick(x.hud);Check(!HudField<SpriteRenderer>(x.hud,"red").enabled&&!HudField<SpriteRenderer>(x.hud,"blue").enabled&&Resources.Loads==loads&&ReferenceEquals(pivot,HudField<Transform>(x.hud,"redPivot")),"missing sprite allocated/retried/shown");Resources.Missing=false;SeojinDualDirectionHud.Ensure(x.control,x.actor);HudTick(x.hud);Check(HudField<SpriteRenderer>(x.hud,"red").enabled&&HudField<SpriteRenderer>(x.hud,"blue").enabled&&ReferenceEquals(pivot,HudField<Transform>(x.hud,"redPivot")),"rebind could not recover same children");});
