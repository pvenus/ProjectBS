  fields:
  - name: discoveryTitle
    value: "\uBC14\uB78C\uC5D0 \uB0A8\uC740 \uAC80\uC2DD"
  - name: discoveryBody
    value: "\uBC14\uB78C\uC774 \uC5B5\uC0C8\uBC2D\uC744 \uB215\uD790 \uB54C\uB9C8\uB2E4
      \uD759 \uC704\uC758 \uC624\uB798\uB41C \uBAA9\uAC80 \uC790\uAD6D\uC774 \uC774\uC5B4\uC9C4\uB2E4.\n\uD55C
      \uAC78\uC74C \uBB3C\uB7EC\uC11C\uC790 \uB04A\uAE34 \uD754\uC801\uC774 \uD558\uB098\uC758
      \uAC80\uB85C\uB85C \uBCF4\uC778\uB2E4.\n\uC7A0\uC2DC \uBA38\uBB38\uB2E4\uBA74
      \uADF8 \uC6C0\uC9C1\uC784\uC744 \uC77C\uD589\uC758 \uBC29\uC2DD\uC73C\uB85C
      \uC775\uD790 \uC218 \uC788\uC744 \uB4EF\uD558\uB2E4."
  - name: capNotice
    value: "\uC774\uBC88 \uC7A5\uC758 \uCD94\uAC00 \uC131\uC7A5\uC740 \uD55C \uBC88\uB9CC
      \uD655\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - name: methodLabel
    value: "\uC131\uC7A5 \uBC29\uC2DD \xB7 \uAD00\uCC30"
  - name: methodSummary
    value: "\uC804\uD22C\uC640 \uBE44\uC6A9 \uC5C6\uC774 \uD754\uC801\uC744 \uAD00\uCC30\uD569\uB2C8\uB2E4."
  - name: rewardSummary
    value: "\uC131\uC7A5 \uC815\uBE44 \xB7 \uBB34\uC791\uC704 \uD6C4\uBCF4 \uCD5C\uB300
      2\uAC1C"
  - name: observeLabel
    value: "\uD754\uC801\uC744 \uB530\uB77C \uAC80\uC2DD\uC744 \uC0B4\uD540\uB2E4"
  - name: observeAssist
    value: "\uBE44\uC6A9 \uC5C6\uC774 \uAD00\uCC30\uC744 \uB9C8\uCE58\uBA74 \uC131\uC7A5
      \uC815\uBE44\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4."
  - name: declineLabel
    value: "\uC5B5\uC0C8\uBC2D\uC744 \uC9C0\uB098\uAC04\uB2E4"
  - name: declineAssist
    value: "\uC131\uC7A5 \uC5C6\uC74C \xB7 \uC774\uBC88 \uC7A5\uC758 \uCD94\uAC00
      \uC131\uC7A5\uC740 \uC544\uC9C1 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - name: confirmTitle
    value: "\uC774 \uAC80\uC2DD\uC744 \uC775\uD788\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - name: confirmBody
    value: "\uBE44\uC6A9 \uC5C6\uC774 \uAD00\uCC30\uC744 \uB9C8\uCE58\uBA74 \uC131\uC7A5
      \uC815\uBE44\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4.\n\uBB34\uC791\uC704 \uD6C4\uBCF4\uB294
      \uCD5C\uB300 2\uAC1C\uC774\uBA70, \uADF8\uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
  - name: confirmCta
    value: "\uAC80\uC2DD\uC744 \uC775\uD78C\uB2E4"
  - name: confirmCancel
    value: "\uB2E4\uC2DC \uC0B4\uD3B4\uBCF8\uB2E4"
  - name: candidateZeroDisabled
    value: "\uC9C0\uAE08\uC740 \uC775\uD790 \uC218 \uC788\uB294 \uAC80\uC2DD\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - name: candidateZeroReason
    value: "\uAC15\uD654 \uAC00\uB2A5\uD55C \uC2A4\uD0AC\uC774 \uC0DD\uAE34 \uB4A4
      \uB2E4\uC2DC \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - name: candidateZeroRecheckCta
    value: "\uB2E4\uC2DC \uD655\uC778"
  - name: alreadyGrantedDisabled
    value: "\uC774\uBC88 \uC7A5\uC758 \uCD94\uAC00 \uC131\uC7A5\uC740 \uC774\uBBF8
      \uD655\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - name: successBody
    value: "\uBC14\uB78C\uC774 \uB2E4\uC2DC \uC5B5\uC0C8\uB97C \uB215\uD788\uC790
      \uB04A\uC5B4\uC9C4 \uAC80\uD754\uC774 \uD558\uB098\uC758 \uD750\uB984\uC73C\uB85C
      \uC774\uC5B4\uC84C\uB2E4.\n\uC77C\uD589\uC740 \uB0A8\uACA8\uC9C4 \uB3D9\uC791\uC744
      \uADF8\uB300\uB85C \uD749\uB0B4 \uB0B4\uC9C0 \uC54A\uACE0, \uAC01\uC790\uC758
      \uC804\uD22C \uBC29\uC2DD\uC5D0 \uB9DE\uCDB0 \uC0C8 \uD638\uD761\uC73C\uB85C
      \uB2E4\uB4EC\uC5C8\uB2E4."
  - name: successStatus
    value: "\uC131\uC7A5 \uAE30\uD68C\uAC00 \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - name: successCta
    value: "\uC131\uC7A5 \uC815\uBE44\uB85C \uC774\uB3D9"
  - name: declineBody
    value: "\uC77C\uD589\uC740 \uD759 \uC704\uC758 \uAC80\uD754\uC744 \uD750\uD2B8\uB7EC\uB728\uB9AC\uC9C0
      \uC54A\uACE0 \uC5B5\uC0C8\uBC2D\uC744 \uBE60\uC838\uB098\uC654\uB2E4.\n\uB4A4\uC5D0\uC11C
      \uBC14\uB78C\uC774 \uD55C \uBC88 \uB354 \uAE38\uC744 \uADF8\uB838\uC9C0\uB9CC,
      \uC774\uBC88\uC5D0\uB294 \uAC78\uC74C\uC744 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
  - name: declineStatus
    value: "\uC131\uC7A5 \uC5C6\uC74C \xB7 \uC774\uBC88 \uC7A5\uC758 \uCD94\uAC00
      \uC131\uC7A5\uC740 \uC544\uC9C1 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - name: declineCta
    value: "\uAE38\uC744 \uACC4\uC18D \uAC04\uB2E4"
  - name: failureBody
    value: "\uAD00\uCC30\uC758 \uACB0\uACFC\uB97C \uD655\uC815\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uC131\uC7A5
      \uAE30\uD68C\uB294 \uC0DD\uAE30\uC9C0 \uC54A\uC558\uC73C\uBA70, \uCD94\uAC00
      \uC131\uC7A5\uB3C4 \uC18C\uBE44\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - name: failureAssist
    value: "\uAC19\uC740 \uC120\uD0DD\uC73C\uB85C \uB2E4\uC2DC \uC2DC\uB3C4\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - name: failureRetryCta
    value: "\uB2E4\uC2DC \uC2DC\uB3C4"
  - name: reminderTemplate
    value: "{ownerName}\uC774(\uAC00) \uBC14\uB78C\uC5D0 \uB0A8\uC740 \uAC80\uC2DD\uC744
      \uB2E4\uB4EC\uC5C8\uC2B5\uB2C8\uB2E4 \xB7 {skillName} Lv {levelBefore}\u2192{levelAfter}"
  - name: candidateTwoStatus
    value: "\uBB34\uC791\uC704 \uC131\uC7A5 \uD6C4\uBCF4 2\uAC1C\uB97C \uD655\uC778\uD569\uB2C8\uB2E4."
  - name: candidateOneStatus
    value: "\uD604\uC7AC \uD655\uC778 \uAC00\uB2A5\uD55C \uBB34\uC791\uC704 \uC131\uC7A5
      \uD6C4\uBCF4\uB294 1\uAC1C\uC785\uB2C8\uB2E4."
  - name: busyStatus
    value: "\uAD00\uCC30\uC758 \uACB0\uACFC\uB97C \uD655\uC815\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
